  "narrative": {
    "northStar": "Die Wachbuch-Auswertung",
    "overview": "Die Oberfläche soll wirken wie ein sauber geführtes Einsatzbuch: sachlich, nachvollziehbar, ohne Effekte. Weiße Karten liegen auf einem blassen, rötlich getönten Grund; Zahlen stehen groß und ruhig, jede mit Fallzahl und Abdeckung daneben.",
    "keyCharacteristics": [
      "Weiße Karten auf blassem Markengrund, weich angehoben",
      "Eine Kennfarbe, abgeleitet in zehn Tönen",
      "Kräftige, kurze Beschriftungen, ruhiger Fließtext",
      "Jede Kennzahl nennt Fallzahl und Abdeckung",
      "Sachlicher Ton, deutsche Fachbegriffe"
    ],
    "rules": [
      {
        "name": "The Wehr-Token Rule",
        "body": "Jede Farbe der Marke kommt aus einem --brand-*-Token.",
        "section": "colors"
      },
      {
        "name": "The One Voice Rule",
        "body": "Eine Kennfarbe pro Wehr; weitere Töne nur durch Abstufung.",
        "section": "colors"
      },
      {
        "name": "The Fall-Zahl Rule",
        "body": "Jede Kennzahl nennt Fallzahl und Abdeckung in derselben Karte.",
        "section": "typography"
      },
      {
        "name": "The Quiet Shadow Rule",
        "body": "Schatten tragen Ebene, nie Schmuck.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do alle Markenfarben über --brand-*-Tokens ansprechen.",
      "Do Kennzahlen immer mit Fallzahl und Abdeckung zeigen.",
      "Do Texte in --gray nicht kleiner als 0,8 rem setzen.",
      "Do Fokus sichtbar halten: 3-px-Ring in --brand-accent."
    ],
    "donts": [
      "Don't --brand-accent oder --day als Textfarbe auf Weiß einsetzen.",
      "Don't helle Grautöne für lesbaren Text verwenden.",
      "Don't Schatten schachteln.",
      "Don't echte Namen in Beispielen zeigen."
    ]
