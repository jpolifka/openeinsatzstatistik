# Kopieren nach .env und anpassen – .env wird nicht eingecheckt.
# Die App hat keine eingebauten Standardwerte: alles, was sie braucht, steht hier.
# DATA_DIR (Datenordner im Container) setzt docker-compose.yml selbst.

# ---------------------------------------------------------------- Betrieb
# Port auf dem Host. Hinter einem Reverse Proxy auf demselben Host nur lokal öffnen: 127.0.0.1:8112
APP_PORT=8112
# Öffentliche Adresse der App (Pflicht, wenn ADMIN_EMAILS gesetzt ist) – daraus entsteht der Link
# in der Mail. Mit https:// wird das Sitzungs-Cookie nur über HTTPS gesendet.
# Lokal z. B. http://localhost:8112, hinter dem Proxy z. B. https://einsatz.example.org
BASE_URL=http://localhost:8112

# ---------------------------------------------------------------- Anmeldung
# Anmeldung per Magic Link. Leer = kein Schutz. Setzen, sobald die App im Netz erreichbar ist.
# Superadmins, durch Komma getrennt; alle anderen Benutzer werden in der App den Wehren zugeordnet.
# (Das frühere AUTH_EMAILS wird nur noch einmalig bei der Umstellung auf Mandanten gelesen.)
ADMIN_EMAILS=
# Schlüssel für Links und Sitzungen. Leer = wird als daten/session.key erzeugt
SECRET_KEY=

# ---------------------------------------------------------------- Mailversand (Anmeldelinks)
# Über das Postfach der eigenen Domain per SMTP. Leer = kein Versand, der Link steht nur im Log.
# Beispiel Strato: smtp.strato.de, 465 mit ssl (oder 587 mit starttls); Benutzer = Postfach-Adresse.
SMTP_HOST=
SMTP_PORT=465
# ssl (Port 465) oder starttls (Port 587) – unverschlüsselt geht nicht
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
# Absender: Adresse des Postfachs (oder ein Alias davon) auf der Domain, deren SPF den SMTP-Server erlaubt
MAIL_FROM=Einsatzstatistik <statistik@example.org>
# DKIM-Signatur durch die App (empfohlen, nötig für DMARC bei weitergeleiteten Mails).
# Schlüssel erzeugen: docker compose exec einsatzberichte python -m app.mail dkim-key
# und den ausgegebenen TXT-Eintrag unter <DKIM_SELECTOR>._domainkey.<Domain> im DNS anlegen.
# Prüfen: docker compose exec einsatzberichte python -m app.mail check
DKIM_SELECTOR=
# Pfad im Container (im Volume, damit der Schlüssel Updates übersteht), z. B. /daten/dkim.key
DKIM_KEY_FILE=

# ---------------------------------------------------------------- Auftragsverarbeitung (AVV)
# Angaben zum Auftragnehmer im Vertrag (siehe README „Datenschutz“). Leer = im Vertrag steht
# „[bitte ergänzen]“. Beispiele: Musterstraße 1, 12345 Musterstadt / M. Muster / datenschutz@example.org
DPA_PROCESSOR_ADDRESS=
DPA_PROCESSOR_REPRESENTATIVE=
DPA_PROCESSOR_CONTACT=
# Hosting-Anbieter (Name, Sitz) und Ort der Verarbeitung, z. B. Rechenzentrum Frankfurt am Main
DPA_HOSTING=
DPA_HOSTING_LOCATION=
# Datensicherung, wie sie im Anhang zum AVV beschrieben wird, z. B. täglich, 30 Tage aufbewahrt
DPA_BACKUP=
# Anbieter des Postfachs für den Mailversand (Name, Sitz) und Ort, z. B. STRATO GmbH, Berlin / Deutschland
DPA_MAIL_PROVIDER=
DPA_MAIL_LOCATION=
