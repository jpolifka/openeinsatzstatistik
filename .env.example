# Kopieren nach .env und anpassen – .env wird nicht eingecheckt.
# Die App hat keine eingebauten Standardwerte: alles, was sie braucht, steht hier.
# DATA_DIR (Datenordner im Container) setzt docker-compose.yml selbst.

# ---------------------------------------------------------------- Betrieb
# Port auf dem Host. Hinter einem Reverse Proxy auf demselben Host nur lokal öffnen: 127.0.0.1:8112
APP_PORT=8112
# Standard: nur lokal erreichbar. Für einen Proxy im gemeinsamen Docker-Netz nicht ändern.
# Nur bei bewusst benötigtem direktem Netzwerkzugriff z. B. 0.0.0.0 setzen.
APP_BIND=127.0.0.1
# Unprivilegierter Container-Benutzer. Ohne Angabe läuft die App als Besitzer von daten/
# (ein neuer, leerer Ordner bekommt UID/GID 10001). Nur setzen, um das zu übersteuern;
# der Benutzer muss auf daten/ lesen und schreiben dürfen. root (0) ist nicht erlaubt.
#APP_UID=1000
#APP_GID=1000
# Öffentliche Adresse der App (Pflicht, wenn ADMIN_EMAILS gesetzt ist) – daraus entsteht der Link
# in der Mail. Mit https:// wird das Sitzungs-Cookie nur über HTTPS gesendet.
# Lokal z. B. http://localhost:8112, hinter dem Proxy z. B. https://einsatz.example.org
BASE_URL=http://localhost:8112
# Optional: Basisdomain für VG-Subdomains. Der Superadmin legt je VG eine Subdomain fest; Anmeldelinks gehen
# nur an <Subdomain>.BASE_DOMAIN einer VG der Person (nie an einen Host aus der Anfrage), sonst an BASE_URL.
# Schema und Port wie BASE_URL; Wildcard-DNS, -Zertifikat und Proxy für *.BASE_DOMAIN sind Sache des Betriebs.
# Eine nicht lokale BASE_URL muss mit https:// beginnen. (Das frühere ALLOWED_DOMAINS ist entfernt.)
#BASE_DOMAIN=example.org

# ---------------------------------------------------------------- Anmeldung
# Anmeldung per Magic Link. Ohne ADMIN_EMAILS startet die App nicht (sonst wäre jeder Zugriff Superadmin).
# Nur für die lokale Entwicklung ohne Anmeldung: AUTH_DISABLED=1 (nur mit lokaler BASE_URL und APP_BIND=127.0.0.1).
#AUTH_DISABLED=1
# Superadmins, durch Komma getrennt; alle anderen Benutzer werden in der App den Wehren zugeordnet.
# (Das frühere AUTH_EMAILS wird nur noch einmalig bei der Umstellung auf Mandanten gelesen.)
ADMIN_EMAILS=
# Schlüssel für Links und Sitzungen. Leer = wird als daten/session.key erzeugt
SECRET_KEY=

# ---------------------------------------------------------------- Mailversand (Anmeldelinks)
# Per SMTP, entweder über das Postfach der eigenen Domain oder über einen Versanddienst.
# Leer = kein Versand, der Link steht nur im Log (nur mit lokaler BASE_URL erlaubt).
# Beispiel Strato: smtp.strato.de, 465 mit ssl (oder 587 mit starttls); Benutzer = Postfach-Adresse.
# Beispiel Brevo (DNS bei Cloudflare, kein Postfach nötig): smtp-relay.brevo.com, 587 mit starttls;
#   Benutzer = SMTP-Login, Passwort = SMTP-Schlüssel (Brevo → SMTP & API); DKIM_* leer lassen (siehe README).
SMTP_HOST=
SMTP_PORT=465
# ssl (Port 465) oder starttls (Port 587) – unverschlüsselt geht nicht
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
# Absender: Adresse des Postfachs (oder ein Alias davon) auf der Domain, deren SPF den SMTP-Server erlaubt;
# bei Brevo eine dort bestätigte Adresse der authentifizierten Domain
MAIL_FROM=Einsatzstatistik <statistik@example.org>
# DKIM-Signatur durch die App (empfohlen bei eigenem Postfach; bei Brevo leer lassen, der Dienst signiert).
# Schlüssel erzeugen: docker compose exec einsatzberichte python -m app.mail dkim-key
# und den ausgegebenen TXT-Eintrag unter <DKIM_SELECTOR>._domainkey.<Domain> im DNS anlegen.
# Prüfen: docker compose exec einsatzberichte python -m app.mail check
DKIM_SELECTOR=
# Pfad im Container (im Volume, damit der Schlüssel Updates übersteht), z. B. /daten/dkim.key
DKIM_KEY_FILE=

# ---------------------------------------------------------------- Impressum (Pflichtangaben des Betreibers)
# Erscheinen unter /impressum, /datenschutz und /barrierefreiheit (ohne Anmeldung erreichbar). Name und Anschrift
# sind vorbelegt (Polifka IT-Beratung); wer die App selbst betreibt, trägt hier die eigenen Angaben ein.
# LEGAL_EMAIL ist Pflicht (ohne Angabe steht „[bitte ergänzen]“ im Impressum und der Start warnt).
#LEGAL_NAME=Polifka IT-Beratung
#LEGAL_ADDRESS=In der Maar 31, 56598 Rheinbrohl
LEGAL_EMAIL=
# Optional: Telefon (zweiter schneller Kontaktweg), Vertretungsberechtigte, Umsatzsteuer-ID
LEGAL_PHONE=
LEGAL_REPRESENTATIVE=
LEGAL_VAT_ID=

# ---------------------------------------------------------------- Auftragsverarbeitung (AVV)
# Angaben zum Auftragnehmer im Vertrag (siehe README „Datenschutz“). Leer = im Vertrag steht
# „[bitte ergänzen]“. Beispiele: Musterstraße 1, 12345 Musterstadt / M. Muster / datenschutz@example.org
DPA_PROCESSOR_ADDRESS=
DPA_PROCESSOR_REPRESENTATIVE=
DPA_PROCESSOR_CONTACT=
# Hosting-Anbieter (Name, Sitz) und Ort der Verarbeitung, z. B. Rechenzentrum Frankfurt am Main
DPA_HOSTING=
DPA_HOSTING_LOCATION=
# Datensicherung, wie sie im Anhang zum AVV beschrieben wird, z. B. täglich, 30 Tage aufbewahrt
DPA_BACKUP=
# Anbieter des Postfachs für den Mailversand (Name, Sitz) und Ort, z. B. STRATO GmbH, Berlin / Deutschland
DPA_MAIL_PROVIDER=
DPA_MAIL_LOCATION=
