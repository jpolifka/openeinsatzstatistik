# Kopieren nach .env und anpassen – .env wird nicht eingecheckt.
APP_PORT=8112

# Anmeldung per Magic Link. Leer = kein Schutz. Setzen, sobald die App im Netz erreichbar ist.
# Berechtigte Adressen, durch Komma getrennt:
AUTH_EMAILS=
# Adresse, unter der die App erreichbar ist – daraus entsteht der Link in der Mail
BASE_URL=http://localhost:8112
# Versand über Resend (https://resend.com). Ohne Schlüssel steht der Link nur im Log.
RESEND_API_KEY=
# Absender, Domain muss in Resend verifiziert sein
MAIL_FROM=Einsatzstatistik <statistik@example.org>
